{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react-dom": ["../node_modules/@types/react-dom"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
