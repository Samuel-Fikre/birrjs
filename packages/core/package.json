{
  "name": "@birrjs/core",
  "version": "0.1.0",
  "description": "Ethiopian payment billing and subscription management for TypeScript",
  "license": "MIT",
  "bin": {
    "birrjs": "./dist/cli/index.js"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./cli": {
        "default": "./dist/cli/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --build",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.1.21",
    "@clack/prompts": "^1.4.0",
    "@commander-js/extra-typings": "^14.0.0",
    "better-call": "^2.0.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "jiti": "^2.7.0",
    "nanoid": "^5.0.9",
    "node-cron": "^4.2.1",
    "package-manager-detector": "^1.6.0",
    "pg": "^8.20.0",
    "picocolors": "^1.1.1",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.5",
    "pino-pretty": "^11.0.0",
    "tsdown": "^0.21.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.6"
  }
}
